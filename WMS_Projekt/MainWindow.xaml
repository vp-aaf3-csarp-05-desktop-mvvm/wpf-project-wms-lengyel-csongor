<Window x:Class="WMS_Projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Projekt"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:EmployeeViewModell/>
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        <Label Content="Név :" Grid.Column="0" Grid.Row="0"/>
        <TextBlock Text="{Binding Name}" Grid.Column="1" Grid.Row="0"/>
        <Label Content="Adószám :" Grid.Column="0" Grid.Row="1"/>
        <TextBlock Text="{Binding TaxNumber}" Grid.Column="1" Grid.Row="1"/>
        <Label Content="Szabad napok :" Grid.Column="0" Grid.Row="2"/>
        <TextBlock Text="{Binding UsedDaysOff}" Grid.Column="1" Grid.Row="2"/>

    </Grid>
</Window>
