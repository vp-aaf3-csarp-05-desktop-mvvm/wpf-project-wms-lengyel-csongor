<Window x:Class="WMS_Projekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WMS_Projekt"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <local:EmployeeViewModell/>
    </Window.DataContext>
    <WrapPanel>
        <Border BorderBrush="Black" BorderThickness="2" CornerRadius="10" Margin="10" Padding="10">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Label Content="Név :" Grid.Column="0" Grid.Row="0" FontWeight="Bold"/>
                <TextBlock Text="{Binding Name}" Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" />
                <Label Content="Adószám :" Grid.Column="0" Grid.Row="1" FontWeight="Bold"/>
                <TextBlock Text="{Binding TaxNumber}" Grid.Column="1" Grid.Row="1" VerticalAlignment="Center" />
                <Label Content="Kivett szabad napok :" Margin="0 0 5 0" Grid.Column="0" Grid.Row="2" FontWeight="Bold"/>
                <TextBox Text="{Binding DaysOff, UpdateSourceTrigger=PropertyChanged}" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" />
                <Label Content="Maradék napok" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" HorizontalContentAlignment="Left" FontWeight="Bold"/>
                <TextBlock Text="{Binding RemainingDays}" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" />

            </Grid>
    </Border>
    </WrapPanel>
  
</Window>
